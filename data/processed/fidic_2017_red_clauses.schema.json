{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fidic_2017_red_clauses.schema.json",
  "title": "FIDIC 2017 Red Book local source layer",
  "type": "object",
  "required": [
    "schema_version",
    "book",
    "edition",
    "source_file",
    "source_text_origin",
    "source_status",
    "verification_status",
    "source_sha256",
    "main_clause_count",
    "sub_clause_count",
    "main_clauses",
    "clauses",
    "quality_control"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "book": { "const": "FIDIC Red Book 2017" },
    "edition": { "const": "2017" },
    "source_file": { "type": "string", "minLength": 1 },
    "source_text_origin": { "enum": ["Word manual copy", "Corrected Word working copy"] },
    "source_status": { "const": "source_text_loaded" },
    "verification_status": { "const": "needs_pdf_verification" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "main_clause_count": { "type": "integer", "const": 21 },
    "sub_clause_count": { "type": "integer", "minimum": 1 },
    "main_clauses": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/mainClause" }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/subClause" }
    },
    "quality_control": { "type": "object" }
    ,
    "pdf_verification": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "commonClause": {
      "type": "object",
      "required": [
        "id",
        "book",
        "edition",
        "source_form",
        "parent_clause_no",
        "parent_clause_title",
        "clause_no",
        "clause_title",
        "level",
        "original_order",
        "source_text_origin",
        "source_status",
        "verification_status",
        "parsing_status",
        "qc_notes",
        "functional_mappings",
        "tags",
        "clause_elements"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^fidic_2017_red_[0-9_]+$" },
        "book": { "const": "FIDIC Red Book 2017" },
        "edition": { "const": "2017" },
        "source_form": { "const": "FIDIC 2017 Red" },
        "parent_clause_no": { "type": "string", "pattern": "^[0-9]+$" },
        "parent_clause_title": { "type": "string", "minLength": 1 },
        "clause_no": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
        "clause_title": { "type": "string", "minLength": 1 },
        "level": { "enum": ["main-clause", "sub-clause"] },
        "original_order": { "type": "integer", "minimum": 0 },
        "source_text_origin": {
          "enum": [
            "Word manual copy",
            "Corrected Word working copy",
            "PDF reference text matched to Word manual copy",
            "PDF reference text matched to corrected Word working copy"
          ]
        },
        "source_status": { "const": "source_text_loaded" },
        "verification_status": {
          "enum": ["needs_pdf_verification", "pdf_text_matched"]
        },
        "parsing_status": { "enum": ["parsed", "needs_review"] },
        "qc_notes": { "type": "array", "items": { "type": "string" } },
        "functional_mappings": { "type": "array", "maxItems": 0 },
        "tags": { "type": "array", "maxItems": 0 },
        "clause_elements": { "type": "array", "maxItems": 0 },
        "pdf_source_file": { "type": "string", "minLength": 1 },
        "pdf_page_reference": { "type": ["string", "null"] },
        "pdf_verification_status": {
          "enum": [
            "pdf_verified",
            "text_matches_with_minor_formatting_differences",
            "title_mismatch",
            "clause_number_mismatch",
            "text_discrepancy_found",
            "imported_text_missing",
            "pdf_text_unavailable",
            "pdf_ocr_unreliable_needs_manual_review",
            "needs_manual_pdf_review"
          ]
        },
        "text_match_status": {
          "enum": [
            "exact_or_near_exact_match",
            "minor_formatting_difference_only",
            "substantive_difference_possible",
            "missing_text",
            "unable_to_compare_reliably"
          ]
        },
        "qc_status": {
          "enum": [
            "pdf_verified",
            "needs_pdf_verification",
            "needs_manual_pdf_review",
            "text_discrepancy_found",
            "source_text_not_loaded",
            "pdf_ocr_unreliable_needs_manual_review"
          ]
        },
        "qc_note": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "verified_by": { "const": "codex_pdf_verification" },
        "pdf_verification": {
          "type": "object",
          "required": ["reference_file", "method", "verified_at_utc", "page_hits"],
          "properties": {
            "reference_file": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "verified_at_utc": { "type": "string", "format": "date-time" },
            "page_hits": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    },
    "mainClause": {
      "allOf": [
        { "$ref": "#/$defs/commonClause" },
        {
          "type": "object",
          "required": ["sub_clause_count"],
          "properties": {
            "level": { "const": "main-clause" },
            "sub_clause_count": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "subClause": {
      "allOf": [
        { "$ref": "#/$defs/commonClause" },
        {
          "type": "object",
          "required": ["full_text", "paragraphs", "literal_cross_references"],
          "properties": {
            "level": { "const": "sub-clause" },
            "is_container_clause": { "type": "boolean", "default": false },
            "child_clause_numbers": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
              "uniqueItems": true
            },
            "full_text": { "type": "string" },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["order", "label", "text"],
                "properties": {
                  "order": { "type": "integer", "minimum": 0 },
                  "label": { "type": ["string", "null"] },
                  "text": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "literal_cross_references": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
              "uniqueItems": true
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["is_container_clause"],
                "properties": { "is_container_clause": { "const": true } }
              },
              "then": {
                "required": ["child_clause_numbers"],
                "properties": {
                  "full_text": { "const": "" },
                  "child_clause_numbers": { "minItems": 1 }
                }
              },
              "else": {
                "properties": { "full_text": { "minLength": 1 } }
              }
            }
          ]
        }
      ]
    }
  }
}
