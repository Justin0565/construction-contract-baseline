{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pc_review_project_v1_1.schema.json",
  "title": "Particular Conditions Review Project — Task 3",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "export_timestamp",
    "project",
    "source_documents",
    "amendments",
    "alignment_assessments",
    "alignment_decisions",
    "effective_clauses",
    "application_log",
    "processing_history"
  ],
  "properties": {
    "schema_version": { "const": "pc-review-project-1.1" },
    "document_type": { "const": "pc_review_project" },
    "export_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "project": { "$ref": "#/$defs/project" },
    "source_documents": { "type": "array", "items": { "$ref": "pc_review_project.schema.json#/$defs/source_document" } },
    "amendments": { "type": "array", "items": { "$ref": "#/$defs/amendment" } },
    "alignment_assessments": { "type": "array", "items": { "$ref": "#/$defs/alignment_assessment" } },
    "alignment_decisions": { "type": "array", "items": { "$ref": "#/$defs/alignment_decision" } },
    "effective_clauses": { "type": "array", "items": { "$ref": "#/$defs/effective_clause" } },
    "application_log": { "type": "array", "items": { "$ref": "#/$defs/application_log" } },
    "processing_history": { "type": "array", "items": { "$ref": "pc_review_project.schema.json#/$defs/history" } }
  },
  "additionalProperties": true,
  "$defs": {
    "nullable_string": { "type": ["string", "null"] },
    "alignment_status": {
      "enum": [
        "Not Assessed",
        "Exact Match",
        "Target Text Match",
        "Number Match / Heading Difference",
        "Heading Match / Number Difference",
        "Probable Match",
        "Ambiguous",
        "Unmatched",
        "New Clause",
        "Blocking Dependency",
        "Human Confirmed",
        "Rejected"
      ]
    },
    "machine_alignment_status": {
      "enum": [
        "Not Assessed",
        "Exact Match",
        "Target Text Match",
        "Number Match / Heading Difference",
        "Heading Match / Number Difference",
        "Probable Match",
        "Ambiguous",
        "Unmatched",
        "New Clause",
        "Blocking Dependency"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "project_name",
        "contract_reference",
        "fidic_form",
        "fidic_edition",
        "baseline_id",
        "baseline_verification_status",
        "consolidation_mode",
        "publication_eligible",
        "baseline_source_sha256",
        "baseline_source_layer_sha256",
        "created_at",
        "updated_at",
        "project_status",
        "source_document_ids",
        "amendment_ids",
        "alignment_assessment_ids",
        "alignment_decision_ids",
        "effective_clause_ids",
        "application_ids",
        "notes"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "project_name": { "type": "string", "minLength": 1 },
        "contract_reference": { "$ref": "#/$defs/nullable_string" },
        "fidic_form": { "const": "Red Book" },
        "fidic_edition": { "const": "2017" },
        "baseline_id": { "const": "fidic_red_2017" },
        "baseline_verification_status": { "const": "Not Verified" },
        "consolidation_mode": { "const": "Preview / Unverified Baseline" },
        "publication_eligible": { "const": false },
        "baseline_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "baseline_source_layer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "project_status": { "enum": ["Source Loaded", "Requires Preprocessing", "Amendments Not Yet Identified", "Amendments Identified", "Clause Alignment Not Started", "Clause Alignment Review", "Clause-specific Consolidation"] },
        "source_document_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "amendment_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "alignment_assessment_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "alignment_decision_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "effective_clause_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "application_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "notes": { "$ref": "#/$defs/nullable_string" }
      },
      "additionalProperties": true
    },
    "amendment": {
      "type": "object",
      "required": [
        "amendment_id",
        "project_id",
        "pc_source_document_id",
        "pc_source_reference",
        "pc_instruction_text",
        "pc_instruction_summary",
        "pc_clause_number",
        "pc_clause_heading",
        "parent_clause",
        "target_gc_clause_id",
        "target_gc_clause_number",
        "target_gc_heading",
        "target_basis",
        "target_location",
        "amendment_operation",
        "target_text",
        "replacement_or_added_text",
        "sequence_number",
        "amendment_category",
        "alignment_status",
        "machine_alignment_status",
        "application_status",
        "verification_status",
        "effective_clause_id",
        "effective_location",
        "affected_element_ids",
        "affected_tag_ids",
        "global_dependency_ids",
        "human_review_required",
        "source_confidence",
        "notes"
      ],
      "properties": {
        "amendment_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "pc_source_document_id": { "type": "string", "minLength": 1 },
        "pc_source_reference": { "type": "string", "minLength": 1 },
        "pc_instruction_text": { "type": "string", "minLength": 1 },
        "pc_instruction_summary": { "$ref": "#/$defs/nullable_string" },
        "pc_clause_number": { "$ref": "#/$defs/nullable_string" },
        "pc_clause_heading": { "$ref": "#/$defs/nullable_string" },
        "parent_clause": { "$ref": "#/$defs/nullable_string" },
        "target_gc_clause_id": { "$ref": "#/$defs/nullable_string" },
        "target_gc_clause_number": { "$ref": "#/$defs/nullable_string" },
        "target_gc_heading": { "$ref": "#/$defs/nullable_string" },
        "target_basis": { "enum": ["Original Baseline Text", "Current Effective Text", "Unclear"] },
        "target_location": { "$ref": "#/$defs/nullable_string" },
        "amendment_operation": { "enum": ["Delete Exact Text", "Delete Paragraph", "Delete Entire Sub-Clause", "Replace Exact Text", "Replace Paragraph", "Replace Entire Sub-Clause", "Insert Before", "Insert After", "Add Paragraph", "Add New Sub-Clause", "Amend Clause Heading", "Complete Contract Data", "Renumber", "Amend Cross-reference", "Amend Defined Term", "Global Amendment", "Unclassified Instruction"] },
        "target_text": { "$ref": "#/$defs/nullable_string" },
        "replacement_or_added_text": { "$ref": "#/$defs/nullable_string" },
        "sequence_number": { "type": ["integer", "null"], "minimum": 1 },
        "amendment_category": { "enum": ["Clause-specific Amendment", "Contract Data", "Defined-term Amendment", "Global Amendment", "New Clause", "Unclassified Instruction"] },
        "alignment_status": { "$ref": "#/$defs/alignment_status" },
        "machine_alignment_status": { "anyOf": [{ "$ref": "#/$defs/machine_alignment_status" }, { "type": "null" }] },
        "application_status": { "enum": ["Not Assessed", "Identified – Deferred", "Blocking Dependency", "Not Yet Supported / Human Review Required", "Previewed", "Applied", "Failed", "Rejected", "Rolled Back"] },
        "verification_status": { "const": "Not Verified" },
        "effective_clause_id": { "$ref": "#/$defs/nullable_string" },
        "effective_location": { "$ref": "#/$defs/nullable_string" },
        "affected_element_ids": { "type": "array", "maxItems": 0 },
        "affected_tag_ids": { "type": "array", "maxItems": 0 },
        "global_dependency_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "human_review_required": { "type": "boolean" },
        "source_confidence": { "$ref": "#/$defs/nullable_string" },
        "notes": { "$ref": "#/$defs/nullable_string" }
      },
      "additionalProperties": true
    },
    "alignment_assessment": {
      "type": "object",
      "required": ["alignment_assessment_id", "amendment_id", "assessed_at", "assessed_by", "baseline_id", "baseline_source_sha256", "baseline_source_layer_sha256", "machine_status", "proposed_target", "evidence", "conflicts", "blocking_dependency_ids", "reason", "supersedes_assessment_id"],
      "properties": {
        "alignment_assessment_id": { "type": "string", "minLength": 1 },
        "amendment_id": { "type": "string", "minLength": 1 },
        "assessed_at": { "type": "string", "format": "date-time" },
        "assessed_by": { "type": "string", "minLength": 1 },
        "baseline_id": { "const": "fidic_red_2017" },
        "baseline_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "baseline_source_layer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "machine_status": { "$ref": "#/$defs/machine_alignment_status" },
        "proposed_target": { "type": "object" },
        "evidence": { "type": "object" },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "blocking_dependency_ids": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "supersedes_assessment_id": { "$ref": "#/$defs/nullable_string" }
      },
      "additionalProperties": true
    },
    "alignment_decision": {
      "type": "object",
      "required": ["alignment_decision_id", "amendment_id", "alignment_assessment_id", "action", "previous_alignment_status", "new_alignment_status", "decided_at", "decided_by", "supersedes_decision_id", "processing_history_event_id"],
      "properties": {
        "alignment_decision_id": { "type": "string", "minLength": 1 },
        "amendment_id": { "type": "string", "minLength": 1 },
        "alignment_assessment_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["Confirm Alignment", "Reject Alignment", "Mark Ambiguous", "Clear Manual Decision"] },
        "previous_alignment_status": { "$ref": "#/$defs/alignment_status" },
        "new_alignment_status": { "$ref": "#/$defs/alignment_status" },
        "decided_at": { "type": "string", "format": "date-time" },
        "decided_by": { "type": "string", "minLength": 1 },
        "supersedes_decision_id": { "$ref": "#/$defs/nullable_string" },
        "processing_history_event_id": { "$ref": "#/$defs/nullable_string" }
      },
      "additionalProperties": true
    },
    "change_segment": {
      "type": "object",
      "required": ["segment_id", "order", "segment_type", "source_amendment_id", "source_application_id", "version_number"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "segment_type": { "enum": ["unchanged", "deleted", "added", "replaced"] },
        "text": { "type": "string" },
        "original_text": { "type": "string" },
        "source_amendment_id": { "type": "string", "minLength": 1 },
        "source_application_id": { "type": "string", "minLength": 1 },
        "version_number": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "effective_clause": {
      "type": "object",
      "required": ["effective_clause_id", "project_id", "baseline_clause_id", "clause_number", "clause_heading", "parent_clause_number", "baseline_original_order", "effective_order_key", "baseline_text", "current_effective_text", "current_version_id", "current_version_number", "amendment_ids", "applied_amendment_ids", "failed_amendment_ids", "clause_status", "baseline_verification_status", "effective_verification_status", "publication_eligible", "is_tombstone", "version_history", "structured_change_segments", "unresolved_issues", "created_at", "updated_at"],
      "properties": {
        "effective_clause_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "baseline_clause_id": { "$ref": "#/$defs/nullable_string" },
        "clause_number": { "type": "string", "minLength": 1 },
        "clause_heading": { "$ref": "#/$defs/nullable_string" },
        "parent_clause_number": { "type": "string", "minLength": 1 },
        "baseline_original_order": { "type": ["integer", "null"], "minimum": 0 },
        "effective_order_key": { "type": ["integer", "string"] },
        "baseline_text": { "$ref": "#/$defs/nullable_string" },
        "current_effective_text": { "type": "string" },
        "current_version_id": { "type": "string", "minLength": 1 },
        "current_version_number": { "type": "integer", "minimum": 0 },
        "amendment_ids": { "type": "array", "items": { "type": "string" } },
        "applied_amendment_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "failed_amendment_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "clause_status": { "enum": ["Unchanged", "Amendment Pending", "Partially Applied", "Amended", "Replaced", "Deleted", "New", "Application Failed", "Unresolved"] },
        "baseline_verification_status": { "type": "string", "minLength": 1 },
        "effective_verification_status": { "const": "Not Verified" },
        "publication_eligible": { "const": false },
        "is_tombstone": { "type": "boolean" },
        "version_history": { "type": "array", "items": { "$ref": "#/$defs/effective_version" }, "minItems": 1 },
        "structured_change_segments": { "type": "array", "items": { "$ref": "#/$defs/change_segment" } },
        "unresolved_issues": { "type": "array" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "effective_version": {
      "type": "object",
      "required": ["version_id", "version_number", "parent_version_id", "version_event", "created_by_application_id", "text", "active_amendment_ids", "structured_change_segments", "created_at", "created_by"],
      "properties": {
        "version_id": { "type": "string", "minLength": 1 },
        "version_number": { "type": "integer", "minimum": 0 },
        "parent_version_id": { "$ref": "#/$defs/nullable_string" },
        "version_event": { "enum": ["Baseline", "New Clause Pending", "Applied", "New Clause Created", "Tombstone", "Rollback"] },
        "created_by_application_id": { "$ref": "#/$defs/nullable_string" },
        "text": { "type": "string" },
        "active_amendment_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "structured_change_segments": { "type": "array", "items": { "$ref": "#/$defs/change_segment" } },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "application_log": {
      "type": "object",
      "required": ["application_id", "amendment_id", "effective_clause_id", "attempt_type", "operation", "amendment_category", "target_basis", "input_version", "target_clause_id", "target_clause_number", "target_text", "replacement_or_added_text", "target_location", "sequence_number", "target_occurrence_count", "output_version", "output_text", "application_result", "failure_reason", "change_segments", "attempted_at", "applied_at", "applied_by", "rollback_available", "rolled_back_at", "reverses_application_id", "verification_status"],
      "properties": {
        "application_id": { "type": "string", "minLength": 1 },
        "amendment_id": { "type": "string", "minLength": 1 },
        "effective_clause_id": { "$ref": "#/$defs/nullable_string" },
        "attempt_type": { "enum": ["Preview", "Apply", "Rollback", "Reject"] },
        "operation": { "type": "string", "minLength": 1 },
        "amendment_category": { "type": "string", "minLength": 1 },
        "target_basis": { "enum": ["Original Baseline Text", "Current Effective Text", "Unclear"] },
        "input_version": { "$ref": "#/$defs/nullable_string" },
        "target_clause_id": { "$ref": "#/$defs/nullable_string" },
        "target_clause_number": { "$ref": "#/$defs/nullable_string" },
        "target_text": { "$ref": "#/$defs/nullable_string" },
        "replacement_or_added_text": { "$ref": "#/$defs/nullable_string" },
        "target_location": { "$ref": "#/$defs/nullable_string" },
        "sequence_number": { "type": ["integer", "null"], "minimum": 1 },
        "target_occurrence_count": { "type": ["integer", "null"], "minimum": 0 },
        "output_version": { "$ref": "#/$defs/nullable_string" },
        "output_text": { "$ref": "#/$defs/nullable_string" },
        "application_result": { "enum": ["Previewed", "Applied", "Failed", "Rejected", "Rolled Back"] },
        "failure_reason": { "$ref": "#/$defs/nullable_string" },
        "change_segments": { "type": "array", "items": { "$ref": "#/$defs/change_segment" } },
        "attempted_at": { "type": "string", "format": "date-time" },
        "applied_at": { "type": ["string", "null"], "format": "date-time" },
        "applied_by": { "type": "string", "minLength": 1 },
        "rollback_available": { "type": "boolean" },
        "rolled_back_at": { "type": ["string", "null"], "format": "date-time" },
        "reverses_application_id": { "$ref": "#/$defs/nullable_string" },
        "verification_status": { "const": "Not Verified" }
      },
      "additionalProperties": true
    }
  }
}
